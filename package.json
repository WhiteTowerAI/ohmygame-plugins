{
  "name": "ohmygame-plugins",
  "private": true,
  "type": "module",
  "description": "Builds the index of OhMyGame plugins released on GitHub, mirrors and signs them, and holds the official plugins.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsx src/build-index.ts",
    "test": "tsx --conditions=ohmygame-source --test test/*.test.ts && node scripts/build-interactive-story.mjs --check && npm run test:taptap",
    "typecheck": "tsc --noEmit && tsc -p plugins/interactive-story/runtime",
    "build:feishu": "node scripts/build-feishu.mjs",
    "pretest": "npm run build:feishu && npm run build:computer-use && npm run build:game-tests",
    "build:computer-use": "node scripts/build-computer-use.mjs",
    "build:game-tests": "node scripts/build-game-tests.mjs",
    "test:taptap": "vitest run",
    "build:interactive-story": "node scripts/build-interactive-story.mjs"
  },
  "dependencies": {
    "tar": "7.5.22",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@earendil-works/pi-mcp": "1.3.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@types/node": "^24.3.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.6",
    "protobufjs": "7.6.6",
    "typescript": "^5.9.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "ws": "8.23.0",
    "yauzl": "3.4.0"
  }
}
