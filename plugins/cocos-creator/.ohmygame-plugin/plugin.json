{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/cocos-creator",
  "version": "0.1.1",
  "engines": {
    "ohmygame-api": "^2.35.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "examples": [
    "%example.1%",
    "%example.2%"
  ],
  "beta": true,
  "icon": "./assets/icon.svg",
  "categories": [
    "engine"
  ],
  "activation": { "files": ["settings/v2/packages/project.json", "settings/v2/packages/engine.json"] },
  "appliesTo": [
    "general"
  ],
  "contributes": {
    "commands": [
      {
        "id": "play-in-cocos",
        "title": "%command.start%",
        "run": { "prompt": "Open this project in the Cocos Creator version its package.json names, preview it, and tell me what the game shows and any errors. Don't change files.", "skill": "cocos-creator" },
        "slots": [{ "slot": "game.start" }]
      }
    ],
    "skills": "./skills/"
  }
}
