{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/unreal-engine",
  "version": "1.0.2",
  "engines": {
    "ohmygame-api": "^2.35.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "examples": [
    "%example.1%",
    "%example.2%"
  ],
  "beta": true,
  "icon": "./assets/icon.svg",
  "categories": [
    "engine"
  ],
  "activation": { "files": ["*.uproject"] },
  "appliesTo": [
    "general"
  ],
  "capabilities": {
    "network": [
      "127.0.0.1",
      "localhost"
    ]
  },
  "configuration": {
    "endpoint": {
      "type": "text",
      "title": "%config.endpoint%",
      "description": "%config.endpoint.description%",
      "default": "http://127.0.0.1:8000/mcp"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "play-in-unreal",
        "title": "%command.start%",
        "run": { "prompt": "Open this project's .uproject in the Unreal Editor that matches its EngineAssociation, start Play In Editor, confirm that frames advance, and tell me what the game shows and any errors in the Output Log. Don't change files.", "skill": "unreal-game" },
        "slots": [{ "slot": "game.start" }]
      }
    ],
    "skills": "./skills/",
    "mcpServers": [
      {
        "id": "unreal",
        "title": "%mcp.title%",
        "url": "${config.endpoint}",
        "setup": "%mcp.setup%",
        "docs": "https://dev.epicgames.com/documentation/en-us/unreal-engine/unreal-mcp-in-unreal-editor",
        "tools": [
          "list_toolsets",
          "describe_toolset",
          "call_tool"
        ]
      }
    ],
    "settings": {
      "groups": [
        {
          "rows": [
            {
              "field": "endpoint"
            }
          ]
        }
      ]
    }
  }
}
