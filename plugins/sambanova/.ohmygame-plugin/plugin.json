{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/sambanova",
  "version": "0.1.0",
  "engines": {
    "ohmygame-api": "^2.3.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "categories": [
    "provider"
  ],
  "configuration": {
    "apiKey": {
      "type": "secret",
      "title": "%config.apiKey.title%",
      "description": "%config.apiKey.description%"
    }
  },
  "contributes": {
    "providers": [
      {
        "id": "sambanova",
        "title": "%plugin.name%",
        "icon": "./assets/icon.svg",
        "api": "openai-completions",
        "baseUrl": "https://api.sambanova.ai/v1",
        "apiKey": "apiKey",
        "discoverModels": true
      }
    ]
  }
}
