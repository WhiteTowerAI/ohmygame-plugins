{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/gemini-cli",
  "version": "0.1.0",
  "engines": {
    "ohmygame-api": "^2.4.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "categories": [
    "agent"
  ],
  "capabilities": {
    "processes": [
      "gemini"
    ]
  },
  "contributes": {
    "agents": [
      {
        "id": "gemini",
        "title": "Gemini CLI",
        "icon": "./assets/icon.svg",
        "command": "gemini",
        "args": [
          "--acp"
        ],
        "installUrl": "https://geminicli.com/docs/get-started/installation/",
        "loginCommand": "gemini"
      }
    ]
  }
}
