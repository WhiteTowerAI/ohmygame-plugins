{
  "type": "object",
  "properties": {
    "effect": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "Effect id, category/name, such as fire/torch."
    },
    "source": {
      "type": "string",
      "enum": [
        "builtin",
        "project"
      ],
      "description": "Which copy: the plugin's built-in effect or the project's. Defaults to the project's when it has one."
    },
    "view": {
      "type": "string",
      "enum": [
        "live",
        "sheet",
        "code"
      ]
    },
    "settings": {
      "type": "object",
      "description": "Preview settings; leave one out to keep it.",
      "properties": {
        "seed": {
          "type": "integer"
        },
        "bg": {
          "type": "string",
          "enum": [
            "topstone",
            "dark",
            "ground",
            "sky",
            "light",
            "black",
            "checker"
          ]
        },
        "palette": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "minItems": 2,
          "maxItems": 16,
          "description": "Colour ramp, dark to light; null for the effect's own."
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "duration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 60
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 16,
            "maximum": 1024
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Canvas [width, height] in pixels."
        },
        "flip": {
          "type": "boolean"
        },
        "actor": {
          "type": "string",
          "enum": [
            "full",
            "body",
            "target",
            "hide"
          ]
        },
        "options": {
          "type": "object",
          "description": "The effect's own options from meta.options."
        }
      },
      "additionalProperties": false
    },
    "reset": {
      "type": "boolean",
      "description": "Start from the effect's own settings."
    }
  },
  "required": [
    "effect"
  ],
  "additionalProperties": false
}
