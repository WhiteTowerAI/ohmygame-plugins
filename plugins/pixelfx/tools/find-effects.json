{
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "maxLength": 200,
      "description": "Words to match in names, descriptions and tags, in English or Chinese."
    },
    "category": {
      "type": "string",
      "maxLength": 40,
      "description": "Only this category, such as fire."
    },
    "source": {
      "type": "string",
      "enum": [
        "all",
        "builtin",
        "project"
      ],
      "default": "all"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 30
    }
  },
  "additionalProperties": false
}
