{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/unity",
  "version": "0.1.2",
  "engines": {
    "ohmygame-api": "^2.35.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "examples": [
    "%example.1%",
    "%example.2%"
  ],
  "beta": true,
  "icon": "./assets/icon.svg",
  "categories": [
    "engine"
  ],
  "activation": { "files": ["ProjectSettings/ProjectVersion.txt"] },
  "appliesTo": [
    "general"
  ],
  "contributes": {
    "commands": [
      {
        "id": "play-in-unity",
        "title": "%command.start%",
        "run": { "prompt": "Open this project in the Unity Editor that matches ProjectSettings/ProjectVersion.txt, enter Play Mode, confirm that frames advance, and tell me what the game shows and any errors in the Console. Don't change files.", "skill": "unity-game" },
        "slots": [{ "slot": "game.start" }]
      }
    ],
    "skills": "./skills/"
  }
}
