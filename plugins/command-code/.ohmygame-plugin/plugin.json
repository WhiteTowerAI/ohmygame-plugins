{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/command-code",
  "beta": true,
  "version": "0.2.1",
  "engines": {
    "ohmygame-api": "^2.4.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "categories": [
    "provider",
    "agent"
  ],
  "capabilities": {
    "processes": [
      "command-code"
    ]
  },
  "configuration": {
    "apiKey": {
      "type": "secret",
      "title": "%config.apiKey.title%",
      "description": "%config.apiKey.description%"
    }
  },
  "contributes": {
    "providers": [
      {
        "id": "command-code",
        "title": "%plugin.name%",
        "icon": "./assets/icon.svg",
        "api": "openai-completions",
        "baseUrl": "https://api.commandcode.ai/provider/v1",
        "apiKey": "apiKey",
        "discoverModels": true
      }
    ],
    "agents": [
      {
        "id": "command-code",
        "title": "Command Code",
        "icon": "./assets/icon.svg",
        "command": "command-code",
        "args": [
          "acp"
        ],
        "installUrl": "https://commandcode.ai/docs/quickstart",
        "loginCommand": "command-code login"
      }
    ]
  }
}
