{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/siliconflow-cn",
  "version": "0.2.0",
  "engines": {
    "ohmygame-api": "^2.3.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "categories": [
    "provider"
  ],
  "capabilities": {
    "network": [
      "api.siliconflow.cn",
      "sc-maas.oss-cn-shanghai.aliyuncs.com"
    ]
  },
  "configuration": {
    "apiKey": {
      "type": "secret",
      "title": "%config.apiKey.title%",
      "description": "%config.apiKey.description%"
    }
  },
  "contributes": {
    "providers": [
      {
        "id": "siliconflow-cn",
        "title": "%plugin.name%",
        "icon": "./assets/icon.svg",
        "api": "openai-completions",
        "baseUrl": "https://api.siliconflow.cn/v1",
        "apiKey": "apiKey",
        "discoverModels": true,
        "media": {
          "adapter": "./media/adapter.js",
          "image": {
            "models": [
              {
                "id": "Kwai-Kolors/Kolors",
                "title": "Kolors",
                "resolutions": [
                  "1K"
                ],
                "aspectRatios": [
                  "1:1",
                  "3:4",
                  "9:16"
                ],
                "maxReferenceImages": 1
              },
              {
                "id": "Qwen/Qwen-Image",
                "title": "Qwen-Image",
                "resolutions": [
                  "1K"
                ],
                "aspectRatios": [
                  "1:1",
                  "16:9",
                  "9:16",
                  "4:3",
                  "3:4",
                  "3:2",
                  "2:3"
                ]
              }
            ]
          },
          "video": {
            "maxMinutes": 30,
            "models": [
              {
                "id": "MiniMaxAI/MiniMax-H3",
                "title": "MiniMax-H3",
                "durations": [
                  5,
                  6,
                  8,
                  10,
                  15
                ],
                "resolutions": [
                  "768p",
                  "480p"
                ],
                "aspectRatios": [
                  "16:9",
                  "9:16",
                  "1:1",
                  "4:3",
                  "3:4",
                  "21:9"
                ],
                "maxReferenceImages": 2,
                "referenceModes": [
                  "frame"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}
