{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/claude-code-game-studios",
  "beta": true,
  "version": "1.3.0",
  "engines": {
    "ohmygame-api": "^2.36.0"
  },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "icon": "./assets/icon.svg",
  "categories": ["templates"],
  "keywords": ["claude-code", "agents", "workflow"],
  "links": {
    "homepage": "https://github.com/Donchitos/Claude-Code-Game-Studios"
  },
  "contributes": {
    "templates": [
      {
        "id": "studio",
        "title": "%template.title%",
        "description": "%template.description%",
        "projectType": "general",
        "folder": "./template/"
      }
    ]
  }
}
