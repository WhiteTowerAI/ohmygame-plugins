{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/doubao-voice",
  "version": "0.1.1",
  "engines": {
    "ohmygame-api": "^2.39.0"
  },
  "displayName": "%plugin.name%",
  "description": "%plugin.description%",
  "longDescription": "%plugin.longDescription%",
  "icon": "./assets/icon.svg",
  "categories": ["provider"],
  "beta": true,
  "capabilities": {
    "network": ["openspeech.bytedance.com"]
  },
  "configuration": {
    "apiKey": {
      "type": "secret",
      "title": "%config.key.title%",
      "description": "%config.key.description%"
    },
    "defaultVoiceId": {
      "type": "text",
      "title": "%config.voice.title%",
      "description": "%config.voice.description%"
    }
  },
  "contributes": {
    "providers": [
      {
        "id": "doubao-voice",
        "title": "%provider.name%",
        "icon": "./assets/icon.svg",
        "apiKey": "apiKey",
        "media": {
          "adapter": "./media/adapter.js",
          "auth": {
            "header": "X-Api-Key"
          },
          "audio": {
            "defaultVoiceSetting": "defaultVoiceId",
            "models": [
              {
                "id": "seed-tts-2.0",
                "title": "Doubao Speech Synthesis 2.0",
                "kinds": ["speech"],
                "formats": ["mp3", "ogg_opus"],
                "languages": [
                  "zh-cn",
                  "en",
                  "ja",
                  "es-mx",
                  "id",
                  "pt-br",
                  "pt",
                  "ko",
                  "it",
                  "de",
                  "fr",
                  "th",
                  "vi",
                  "ru",
                  "fil",
                  "ms",
                  "ar",
                  "pl",
                  "tr",
                  "sv",
                  "nl",
                  "no",
                  "uk",
                  "fi",
                  "da",
                  "cs",
                  "hu",
                  "el",
                  "ro",
                  "hi",
                  "es-es"
                ],
                "sampleRatesByFormat": {
                  "mp3": [8000, 16000, 22050, 24000, 32000, 44100, 48000],
                  "ogg_opus": [48000]
                },
                "maxTextCharacters": 10000,
                "speedRange": [-50, 100],
                "speaker": true,
                "pitch": true,
                "volume": true,
                "style": true,
                "readsText": true,
                "ssml": true,
                "speechOptions": true,
                "channels": [1]
              },
              {
                "id": "seed-audio-1.0",
                "title": "Seed Audio 1.0",
                "kinds": ["speech", "sound-effect", "music"],
                "formats": ["mp3", "wav", "ogg_opus"],
                "languages": [
                  "zh-cn",
                  "en",
                  "ja",
                  "ko",
                  "es-mx",
                  "es-es",
                  "de",
                  "fr",
                  "pt-br",
                  "th",
                  "vi",
                  "ms",
                  "fil",
                  "it",
                  "ru",
                  "nl",
                  "pl",
                  "tr"
                ],
                "sampleRatesByFormat": {
                  "wav": [8000, 16000, 24000, 32000, 40000, 44100, 48000],
                  "mp3": [8000, 16000, 24000, 32000, 44100, 48000],
                  "ogg_opus": [48000]
                },
                "maxTextCharacters": 2744,
                "speedRange": [-50, 100],
                "speaker": true,
                "pitch": true,
                "volume": true,
                "style": true,
                "maxDurationSeconds": 120
              }
            ]
          }
        }
      }
    ]
  }
}
